# Environment variables for the node-express server (Node.js / Express).
# Copy this file to `.env` and adjust the values if needed.

# Runtime environment: development (default), test or production.
# APP_ENV is read by the application; the database file is selected with
# DATABASE_URL below, following the same convention as ruby-sinatra
# (storage/<env>.sqlite3).
APP_ENV=development

# SQLite database connection. Each environment keeps its own file under
# storage/, mirroring data/database.yml in ruby-sinatra.
DATABASE_URL="file:./storage/development.sqlite3"

# Port of the server. Keep it on the loopback interface (127.0.0.1):
# this API has no authentication.
# PORT=3000
