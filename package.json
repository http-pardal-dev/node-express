{
  "name": "node-express",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP JSON API built with Node.js and Express, using Prisma and SQLite. Companion to ruby-sinatra, sharing the same API contract.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "node db/seeds",
    "db:studio": "prisma studio",
    "db:setup": "prisma migrate dev && npm run db:seed",
    "test:db:migrate": "cross-env DATABASE_URL=\"file:../storage/test.sqlite3\" prisma migrate deploy",
    "test:db:seed": "cross-env DATABASE_URL=\"file:../storage/test.sqlite3\" node db/seeds",
    "pretest": "npm run test:db:migrate",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "prisma": {
    "seed": "node db/seeds"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "js-yaml": "^4.3.2",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
